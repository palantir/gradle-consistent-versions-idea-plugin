{
  parserClass="com.palantir.gradle.versions.lock.parser.LockParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Lock"
  psiImplClassSuffix="Impl"
  psiPackage="com.palantir.gradle.versions.lock.psi"
  psiImplPackage="com.palantir.gradle.versions.lock.psi.impl"

  elementTypeHolderClass="com.palantir.gradle.versions.lock.psi.LockTypes"
  elementTypeClass="com.palantir.gradle.versions.lock.psi.LockElementType"
  tokenTypeClass="com.palantir.gradle.versions.lock.psi.LockTokenType"
}

simpleFile ::= item_*

private item_ ::= (property | COMMENT | TEST_DEPENDENCIES | CRLF)

property ::= lockGroup COLON lockName COLON lockVersion OPEN_BRACKET lockConstraintCount lockConstraints COLON lockHash CLOSE_BRACKET

lockGroup ::= GROUP
lockName ::= NAME
lockVersion ::= VERSION
lockConstraintCount ::= CONSTRAINT_COUNT
lockConstraints ::= CONSTRAINTS
lockHash ::= HASH