<idea-plugin url="https://github.com/palantir/gradle-consistent-versions-idea-plugin">
  <id>gradle-consistent-versions</id>
  <name>gradle-consistent-versions</name>
  <vendor url="https://github.com/palantir/gradle-consistent-versions-idea-plugin">
    Palantir
  </vendor>

  <description>
    <![CDATA[
    <h2> Gradle Consistent Versions Idea Plugin </h2>

    <p>
    An IntelliJ IDEA plugin for use with <a href="https://github.com/palantir/gradle-consistent-versions" target="_blank">gradle-consistent-versions</a>.
    </p>

    <h3> Features: </h3>

    <ul>
     <li> Automatic <code>--write-locks</code> and Gradle refresh when changes are detected in <code>versions.props</code>.</li>
     <li> Auto-complete for packages and versions in <code>versions.props</code>.</li>
     <li> Syntax parsing and highlighting for <code>versions.props</code> files. With highlighting rules to clearly mark <code>dependency-upgrader</code> controls.</li>
     <li> Create comments automatically using the default IntelliJ shortcuts.</li>
    </ul>

    <h3>Help</h3>

    For further help, see also:

    <ul>
      <li><a href="https://github.com/palantir/gradle-consistent-versions-idea-plugin" target="_blank">GitHub Repository</a></li>
      <li><a href="https://github.com/palantir/gradle-consistent-versions-idea-plugin/issues?q=is%3Aissue+is%3Aopen+sort%3Aupdated-desc" target="_blank">Issue Tracker</a></li>
    </ul>
    ]]>
  </description>

  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.gradle</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!--  Versions Props files  -->
    <projectConfigurable instance="com.palantir.gradle.versions.props.PropsSettingsPage" displayName="Gradle Consistent Versions" id="VersionsPropsSettingsPage"/>
    <fileType name="VersionsProps File" implementationClass="com.palantir.gradle.versions.props.PropsFileType" fieldName="INSTANCE"
              language="VersionsProps" fileNames="versions.props"/>
    <lang.parserDefinition language="VersionsProps" implementationClass="com.palantir.gradle.versions.props.PropsParserDefinition"/>
    <lang.syntaxHighlighterFactory language="VersionsProps"
                                   implementationClass="com.palantir.gradle.versions.props.PropsSyntaxHighlighterFactory"/>
    <completion.contributor language="VersionsProps"
                            implementationClass="com.palantir.gradle.versions.props.VersionCompletionContributor" order="last"/>
    <completion.contributor language="VersionsProps"
                            implementationClass="com.palantir.gradle.versions.props.FolderCompletionContributor"/>
    <lang.commenter language="VersionsProps" implementationClass="com.palantir.gradle.versions.props.PropsCommenter"/>
    <vfs.asyncListener implementation="com.palantir.gradle.versions.props.PropsFileListener"/>
    <annotator language="VersionsProps" implementationClass="com.palantir.gradle.versions.props.PropsCommentAnnotator" />
    <externalSystemTaskNotificationListener implementation="com.palantir.gradle.versions.props.LoadCacheOnGradleProjectRefresh" />
    <applicationService serviceImplementation="com.palantir.gradle.versions.props.GradleCacheExplorer" />

    <!--  Versions Lock files  -->
    <fileType name="VersionsLock File" implementationClass="com.palantir.gradle.versions.lock.LockFileType" fieldName="INSTANCE"
              language="VersionsLock" fileNames="versions.lock"/>
    <lang.parserDefinition language="VersionsLock" implementationClass="com.palantir.gradle.versions.lock.LockParserDefinition"/>
    <lang.syntaxHighlighterFactory language="VersionsLock"
                                   implementationClass="com.palantir.gradle.versions.lock.LockSyntaxHighlighterFactory"/>
  </extensions>
</idea-plugin>
